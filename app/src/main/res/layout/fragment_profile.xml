<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_surface"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:background="@color/card_white"
        android:contentDescription="@string/nav_profile"
        android:padding="16dp"
        android:src="@drawable/ic_profile"
        app:tint="@color/um_blue_primary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:accessibilityHeading="true"
        android:text="@string/profile_name"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/profile_stats"
        android:textColor="@color/status_working"
        android:textSize="15sp"
        android:textStyle="bold" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switchAccessibility"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="32dp"
        android:background="@color/card_white"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/switch_large_text"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

</LinearLayout>